{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test_result.schema.json",
  "title": "TestResult",
  "type": "object",
  "required": ["slice_run_id", "profile", "status", "checks"],
  "properties": {
    "slice_run_id": { "type": "string" },
    "profile": { "type": "string", "enum": ["touch", "kbm", "controller"] },
    "status": { "type": "string", "enum": ["pass", "fail"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "pass"],
        "properties": {
          "name": { "type": "string" },
          "pass": { "type": "boolean" },
          "details": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
